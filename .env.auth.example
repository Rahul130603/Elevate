# Copy these values to .env in this folder. Never commit real secrets.
# OAuth client type: Web application. Authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=
# SMTP sender credentials; for Gmail, use a Google app password (not your login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Browser embed key issued by your AccessEase installation
VITE_ACCESSEASE_KEY=

