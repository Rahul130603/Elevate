# Public base URL of the site (used for canonical URLs, sitemap, RSS and JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Edition: country used for the Google News RSS feeds (IN, US, GB, ...)
NEWS_COUNTRY=IN

# Seconds a feed response stays cached before it is refetched
NEWS_REVALIDATE_SECONDS=300

# Story photos: resolved from the publisher page and cached for 6 hours.
# Set to "off" to only use the generated artwork (no publisher lookups at all).
NEWS_IMAGES=on

# ---------------------------------------------------------------------------
# AI quick briefs on story pages. Give a key to EITHER engine — see README.
# ---------------------------------------------------------------------------
# Option A: Google Gemini (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite

# Option B: any OpenAI-compatible chat provider. Preferred when set, because
# these answer in ~1-3s and their free tiers need no card:
#   Groq          https://api.groq.com/openai/v1        (1,000 requests/day free)
#   Cerebras      https://api.cerebras.ai/v1
#   GitHub Models https://models.github.ai/inference
#   OpenRouter    https://openrouter.ai/api/v1
#   Ollama local  http://localhost:11434/v1
# BRIEF_API_KEY=
# BRIEF_MODEL=openai/gpt-oss-120b
# BRIEF_API_BASE_URL=https://api.groq.com/openai/v1

# Use a long random value in production to protect signed internal story links.
STORY_LINK_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# News source
# ---------------------------------------------------------------------------
# Default: free Google News RSS (no key). Headlines are excellent but it carries
# no images, and resolving a story's publisher URL uses a Google endpoint that
# rate limits by IP.
#
# Add ONE of these keys to switch the whole site to a keyed provider, which
# returns the publisher image + URL + description in the same response. That
# gives every story a real photo and lets the AI brief read the article itself.
#   newsdata.io  -> 200 credits/day free (recommended: strong Indian coverage)
#   gnews.io     -> 100 requests/day free
# The provider switches on automatically; no other setting is needed.
# NEWSDATA_API_KEY=
# GNEWS_API_KEY=

# Force a specific provider instead of auto-detecting the first key present:
#   google-news-rss | newsdata | gnews
# NEWS_PROVIDER=

# How many API pages to fetch per page render (10 articles each; 1 = free tier,
# raise it on a paid plan). Ignored by the Google provider.
# NEWS_API_PAGES=1
