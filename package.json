{
  "name": "event-calendar",
  "version": "1.1.0",
  "description": "Production-Ready Calendar and Event Management System",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build && npm --prefix news-site run build",
    "news:install": "npm --prefix news-site ci --ignore-scripts",
    "news:test": "node --test server/tests/adminNews.test.js",
    "preview": "vite preview",
    "test": "node server/tests/api.test.js",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync",
    "demo:client": "node scripts/client-demo.js",
    "demo:client:local": "node scripts/client-demo.js --local-only",
    "demo:test": "node --test server/tests/clientDemo.test.js"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@ngrok/ngrok": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.15",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "nodemailer": "^10.0.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rss-parser": "^3.13.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
